# ---------- Minecraft ----------
# Open your world to LAN (Esc > Open to LAN, cheats ON) and put the port it shows here.
MC_HOST=localhost
MC_PORT=25565
# Leave blank to auto-detect, or set e.g. 1.21.1
MC_VERSION=
BOT_NAME=Buddy
# Your Minecraft username - the bot follows you and only obeys your "!" commands
OWNER_NAME=YourMinecraftName

# ---------- OpenRouter (Jev + Gemma) ----------
# Get a key at https://openrouter.ai/keys and load ~$10 prepaid credit (that's your hard spend cap)
OPENROUTER_API_KEY=

# ---------- Fast brain (split-second moves) ----------
# jev = TypeSafe Jev via OpenRouter, reflex = free coded rules
FAST_BRAIN=jev
JEV_MODEL=typesafe/jev-1.14
# Decisions per second while there's action (Jev is never called when it's calm)
JEV_HZ=3
# Stop using Jev for this session after spending this much USD (falls back to reflex)
JEV_MAX_SPEND_PER_SESSION=1.00

# ---------- Talk brain (personality) ----------
# openrouter = Gemma in the cloud (cheap), ollama = local on your PC (free, slower)
TALK_PROVIDER=openrouter
TALK_MODEL=google/gemma-4-26b-a4b-it
# For ollama use e.g. TALK_MODEL=gemma4:12b (or an "abliterated" community build for no filter)
OLLAMA_URL=http://localhost:11434

# ---------- Voice ----------
# elevenlabs | piper | none
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs Voice Library and paste its Voice ID
ELEVENLABS_VOICE_ID=
# Free tier is ~10,000 characters/month; the bot switches to Piper/text when it gets close
ELEVENLABS_MONTHLY_CHARS=10000
# Piper (free offline voice): https://github.com/rhasspy/piper/releases
PIPER_EXE=W:\\piper\\piper.exe
PIPER_MODEL=W:\\piper\\en_US-ryan-high.onnx

# ---------- Ears (push-to-talk sidecar) ----------
# The Python sidecar posts what you said here
EARS_PORT=3077
